<IfModule mod_rewrite.c>
    RewriteEngine On

    # If requesting the project root without a trailing slash, redirect to append it.
    # This prevents Apache from appending "public/" in its default DirectorySlash redirect.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*?[^/])$ %{REQUEST_URI}/ [L,R=301]

    # Rewrite all requests to the public/ directory if not already there
    RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>
